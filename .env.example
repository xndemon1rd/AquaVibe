# Advanced error system (Telegram LOGGER_ID + local structured JSONL)
ERROR_SYSTEM_ENABLED=true
REMOTE_ERROR_REPORTING=true
ERROR_DEDUP_WINDOW_SEC=300
ERROR_MAX_PER_WINDOW=30
ERROR_LOG_FILE=runtime_errors.jsonl
ERROR_INCLUDE_TRACEBACK=true
ERROR_REDACT_SECRETS=true

# Privacy/safety defaults
CHATLOG_ENABLED=false
AUTO_BACKUP_ENABLED=false

# Voice assistants: enable for music/voice playback
ASSISTANTS_ENABLED=true

# Telegraph/Catbox/upscale/background-removal external uploads
EXTERNAL_UPLOADS_ENABLED=true
