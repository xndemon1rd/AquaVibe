# Optional logging / assistants
LOGGER_ID=0
LOGGER_CHAT=
LOGGER_INVITE_LINK=
STRING_SESSION=
STRING_SESSION2=
STRING_SESSION3=
STRING_SESSION4=
STRING_SESSION5=
